.DS_Store
node_modules/
dist/
*.local.json

# Local token drop-point — nothing in it is ever tracked. How to create the one
# useful token lives in docs/releasing.md §Secrets.
.secrets/
# `npm pack` emits type-stripped .js beside each server .ts (see
# viewer/server/tsconfig.pack.json) and postpack deletes them — this guards a
# crashed pack from committing strays. fallback-sw.js is real, tracked source.
viewer/server/**/*.js
!viewer/server/fallback-sw.js


# Session worktrees and local Claude state (EnterWorktree puts worktrees here).
.claude/

# The skill's eval suite is source (`evals/<case>/`, measured-console phase 9);
# what `claude plugin eval` writes beside it is not — every run's results land in
# `evals/results/<timestamp>/`. Neither ships (`.github/scripts/assert-tarball.sh`
# names `evals/` in its never-ship set).
evals/results/


# The real-browser harness (viewer/e2e): the tour's pictures are for a person to
# READ, never to diff, and Playwright's own results are one run's leavings.
viewer/e2e/.shots/
viewer/e2e/.results/

# A materialized plugin tree (`scripts/build-plugin-tree.mjs --out …`, measured-console
# phase 10): output, never source — the plan's verification writes one here.
.plugin-tree-verify
