# The server is still zero-dependency plain Node. The CLIENT is now a built Vite
# app (React + Tailwind), so node_modules and the build output are generated and
# must never be committed. package.json + package-lock.json ARE committed so a
# clean checkout can `npm ci && npm run build`.
node_modules/
client/dist/
# `npm run verify:dist` builds here so the live client/dist is never touched.
client/.dist-verify/
# scripts/gates.sh builds the client ONCE per commit here, and every stage that
# reads a build reads this one (measured-console phase 7).
client/.dist-*/
# `deploy/self-update.sh` moves the live client here for the instant of a swap.
client/.dist-previous/
dist/
*.local.json
.DS_Store

# The suite ledger `npm test` writes, and the incremental caches of tsc, eslint
# and prettier (measured-console phase 7).
.cache/

# Vite / Vitest caches
.vite/
coverage/
