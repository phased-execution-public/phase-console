#!/usr/bin/env bash
# pre-push — run the gates before a push leaves this machine. Installed by
# `scripts/gates.sh --install-hook` (core.hooksPath = scripts/git-hooks), so
# this file is versioned and the same for every clone.
#
#   main or a tag among the refs  → scripts/gates.sh          (the full matrix)
#   anything else                 → scripts/gates.sh --quick
#   a delete (local sha all zero) → counts for nothing
#
# A green full run recorded for HEAD on a clean tree stands in for the full
# matrix, so pushing main right after `scripts/gates.sh` does not cost the
# matrix twice — read from the repository's COMMON gitdir, so a run in a linked
# worktree (a console run's mirror) counts here, and only when its JSON names
# every stage `gates.sh --list` prints (scripts/gates-marker.sh). PHASE_CONSOLE_SKIP_GATES=1 skips everything and says so —
# the emergency door, named in docs/releasing.md.
#
# git passes: <remote name> <remote url> as argv, and one line per ref on
# stdin: <local ref> <local sha> <remote ref> <remote sha>.
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GATES="$HERE/../gates.sh"
ZERO=0000000000000000000000000000000000000000

# git hands a hook its own view of this repository — in a submodule checkout an
# ABSOLUTE GIT_DIR. The gates run git in other repositories (the bats suites'
# temp repos, a sibling checkout the site reads), and an inherited GIT_DIR
# points every one of them here. Drop it; discovery from the cwd finds this
# repository again for the two git calls below.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_PREFIX

if [ "${PHASE_CONSOLE_SKIP_GATES:-}" = "1" ]; then
  echo "pre-push: PHASE_CONSOLE_SKIP_GATES=1 — gates skipped; what you are pushing is unverified." >&2
  exit 0
fi

mode=quick
while read -r _lref lsha rref _rsha; do
  [ "$lsha" = "$ZERO" ] && continue
  case "$rref" in
    refs/heads/main|refs/tags/*) mode=full ;;
  esac
done

if [ "$mode" = full ]; then
  # shellcheck source=../gates-marker.sh
  . "$HERE/../gates-marker.sh"
  root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  # shellcheck disable=SC2046 # the stage list is one word per stage by construction
  if why="$(gates_marker_check "$root" $(bash "$GATES" --list))"; then
    echo "pre-push: a recorded green run of the full matrix covers $(git rev-parse --short=7 HEAD) on a clean tree — not rerunning the full gates." >&2
    exit 0
  fi
  echo "pre-push: main or a tag is being pushed — running the full gates (scripts/gates.sh): $why." >&2
  exec bash "$GATES"
fi
echo "pre-push: running the quick gates (scripts/gates.sh --quick)." >&2
exec bash "$GATES" --quick
