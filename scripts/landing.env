# Where a phase's work HAPPENS and where it LANDS — the bash twin.
# SINGLE SOURCE OF TRUTH (F5 pattern, like gates.env), but the OWNERS here are
# viewer/shared/landing-model.js (the landing words) and
# viewer/shared/worktree-model.js (the isolation and retention words). This
# file is their bash half: sourced by scripts/phase-graph.sh (the --land,
# --base-branch, --gitlink, --conflict-policy, --isolation arms, the
# landed/pr-merged gates and lints F27/F28) and by scripts/phase-landing.sh.
# viewer/test/gates-vocab.test.ts asks bash for every list below and holds it
# to the JS owner word for word, so the two can never disagree. Change BOTH.
#
# Plain KEY="VALUE" (sourced by bash 3.2) — space-separated tokens.
#
# Two vocabularies share one file because they answer one question in two
# halves — a phase runs somewhere and its commits end up somewhere — and both
# are read by the same six arms of the same script. A fourth .env would put the
# halves in two places without separating any two readers.

#   LAND_POLICIES   — what happens to a phase's commits when it settles:
#                     hold (nothing; a person merges) · integrate (into the
#                     run's integration branch, locally) · pr (pushed, a pull
#                     request opened) · trunk (merged onto the base branch).
#   DEFAULT_LAND    — `hold`, which is what the console does today: a plan that
#                     says nothing must keep behaving as its author watched it.
LAND_POLICIES="hold integrate pr trunk"
DEFAULT_LAND="hold"

#   GITLINK_POLICIES — whether a superproject phase that lands also moves the
#                      gitlink. `bump` by default: a submodule commit nothing
#                      points at is a commit the superproject cannot see.
GITLINK_POLICIES="bump leave"
DEFAULT_GITLINK="bump"

#   CONFLICT_POLICIES — what to do when a landing will not merge cleanly:
#                       halt (today) · park (this phase only, keep driving) ·
#                       rebase-session (board a session to do the rebase).
CONFLICT_POLICIES="halt park rebase-session"
DEFAULT_CONFLICT="halt"

#   BASE_BRANCH_WORDS — the two base-branch values that are WORDS rather than
#                       refs. Everything else in a `**Base branch:**` line is a
#                       git ref and passes through untouched.
BASE_BRANCH_WORDS="origin/HEAD head"
DEFAULT_BASE_BRANCH="origin/HEAD"

#   LANDING_STATES    — where a phase's landing has got to, as
#                       docs/handoffs/<slug>/landing.md records it. A PATH, not
#                       a set of flags: pushed → pr-open → pr-merged is the
#                       `pr` policy's whole journey.
#   LANDED_BY_POLICY  — the state each policy ENDS at, which is what a
#                       `landed N` gate asks about. bash 3.2 has no associative
#                       arrays, so it is `policy:state` pairs.
#   PR_MERGED_STATES  — what a `pr-merged N` gate accepts.
LANDING_STATES="held integrated pushed pr-open pr-merged landed conflict failed"
LANDED_BY_POLICY="hold:held integrate:integrated pr:pr-merged trunk:landed"
PR_MERGED_STATES="pr-merged"

#   ISOLATION_DIRECTIVES   — the per-phase `- **Isolation:**` words, which are
#                            NOT the run's ISOLATION_MODES (queue|worktree): a
#                            phase says `shared` where a run says `queue`,
#                            because `queue` is a claim about the scheduler
#                            that a phase cannot make.
#   WORKTREE_RETENTION     — what becomes of a run's worktree when it settles.
#                            `ttl:<h>` is a fourth, parameterised member and is
#                            deliberately absent from this list: a list is what
#                            an `in` test reads, and `ttl:48` is not in any list.
#   WORKTREE_LOCK_PREFIXES — the first token of a `git worktree lock --reason`
#                            this console wrote. A sweep must never take a tree
#                            somebody else locked, so "is this lock mine?" is
#                            asked of the reason's first word and nothing else.
ISOLATION_DIRECTIVES="shared worktree"
WORKTREE_RETENTION="prune keep-on-failure keep"
DEFAULT_RETENTION="keep-on-failure"
WORKTREE_LOCK_PREFIXES="phase-console"
