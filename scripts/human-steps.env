# A person's turn — the words for a HUMAN STEP, the bash twin.
# SINGLE SOURCE OF TRUTH (F5 pattern, like gates.env), but the OWNER is
# viewer/shared/human-step-model.js. This file is its bash half: sourced by
# scripts/phase-graph.sh (the --human-steps arm and lints F37/F38) and by
# scripts/phase-outcome.sh (the --step flags of a needs-human declaration and
# the refusal of a secret-shaped value). viewer/test/gates-vocab.test.ts asks
# bash for every list below and holds it to the JS owner word for word, so the
# two can never disagree. Change BOTH.
#
# Plain KEY="VALUE" (sourced by bash 3.2) — space-separated tokens, except the
# two lists whose members contain spaces or `$` (SIGN_IN_SHAPES is
# `|`-separated; the patterns are single-quoted).

#   HUMAN_STEP_KINDS  — every scenario a person may be asked for, in the
#                       catalogue's order (control-tower §Architecture 12).
#                       Eighteen and closed: an unknown word fails the lint (F37).
#                       operator-act is the operator's own act (phase 121); the
#                       last, permission, is a wall the AI met (phase 130).
HUMAN_STEP_KINDS="browser-login device-code one-time-code secret-entry claude-login mcp-login os-prompt os-permission third-party-approval physical person-check decision protected-path interactive-prompt captcha email-link operator-act permission"

#   HUMAN_STEP_STATES — where a step has got to, a path: (upcoming →) declared →
#                       notified → opened → checking → proven; the last four
#                       settle it. upcoming: born before its due-when ref lands.
#   HUMAN_STEP_OPEN_STATES — the five a step is still open in.
HUMAN_STEP_STATES="upcoming declared notified opened checking returned proven declined expired cannot dismissed"
HUMAN_STEP_OPEN_STATES="upcoming declared notified opened checking returned"

#   HUMAN_STEP_WHERE     — where the act can be done: at the machine, or anywhere.
#   HUMAN_STEP_AUTO_OPEN — the one value `auto-open:` takes (a PLAN step only).
#   HUMAN_STEP_BIRTHS    — the plan, a session, the console, the supervisor (Pro
#                          raises its escalations as items — control-tower phase 136).
HUMAN_STEP_WHERE="host any"
HUMAN_STEP_AUTO_OPEN="host"
HUMAN_STEP_BIRTHS="plan session console supervisor"

#   HUMAN_STEP_BULLET_KEYS — the keyed fields of the plan bullet, after the
#                            kind and what to do:
#     - **Human step:** <kind> · <what> · open: <url or command> · proof: <ref>
#       · where: host|any · window: 2d [· auto-open: host] [· credential: <id>]
#       [· due: <ref>]   — upcoming until the ref lands (phase 121)
HUMAN_STEP_BULLET_KEYS="open proof where window auto-open credential due why effort unblocks guide"

# The verbs a person presses on a step, and every word a ledger move line's
# `verb` records (control-tower phases 43, 130, 133 and 134) — `attach` is
# pressed at `/api/human-steps/:id/evidence`; `answer`, `decline`, `override`
# (the owner's Accept anyway, phase 134) and `rewrite` (the escalation's
# Rewrite the guide — it withdraws the item) carry authority.
HUMAN_STEP_VERBS="open check snooze cannot dismiss answer decline ask attach override rewrite"
HUMAN_STEP_MOVES="due notify remind open check prove snooze cannot dismiss expire wait return decline answer ask attach override rewrite"

#   HUMAN_STEP_DEFAULT_WHERE — each kind's `where` when the step does not say,
#                              as `kind:where` pairs (bash 3.2 has no
#                              associative arrays) — KIND_META's `where`.
HUMAN_STEP_DEFAULT_WHERE="browser-login:host device-code:any one-time-code:host secret-entry:any claude-login:host mcp-login:host os-prompt:host os-permission:host third-party-approval:any physical:host person-check:any decision:any protected-path:host interactive-prompt:host captcha:any email-link:any operator-act:host permission:any"

#   HUMAN_STEP_SECRET_PATTERNS — a secret's shapes, POSIX EREs matched
#                                case-insensitively (`shopt -s nocasematch`):
#                                token prefixes, a password as an assignment or
#                                a flag, a PEM key, a 6–8 digit code alone.
#   HUMAN_STEP_SECRET_QUERY_KEYS — URL query parameters whose value is a secret.
HUMAN_STEP_SECRET_PATTERNS='gh[pousr]_[[:alnum:]]{30,} github_pat_[[:alnum:]_]{40,} sk-[[:alnum:]_-]{20,} (sk|rk)_(live|test)_[[:alnum:]]{16,} npm_[[:alnum:]]{30,} xox[abposr]-[[:alnum:]-]{10,} (akia|asia)[[:alnum:]]{16} aiza[[:alnum:]_-]{30,} eyj[[:alnum:]_-]{10,}\.[[:alnum:]_-]{10,}\.[[:alnum:]_-]{5,} bearer[[:space:]]+[[:alnum:]._~+/=-]{20,} -----begin[^-]{0,40}private[[:space:]]key (password|passwd|passphrase|pwd|secret|api[_-]?key|access[_-]?key|client[_-]?secret)=[^&[:space:]]{4,} (password|passwd|passphrase)"?[[:space:]]*:[[:space:]]*"?[^[:space:]"]{4,} --(password|passwd|token|secret|api-key)[[:space:]]+[^-[:space:]][^[:space:]]{3,} (^|[^[:alnum:]#./:-])[0-9]{6,8}([^[:alnum:]./-]|$)'
HUMAN_STEP_SECRET_QUERY_KEYS="token access_token id_token refresh_token auth_token code otp password passwd pwd secret client_secret api_key apikey key sig signature x-amz-signature x-amz-credential x-amz-security-token session sessionid"

#   SIGN_IN_SHAPES — the interactive sign-in commands the console's guard knows
#                    (phase 44): in a `-p` session each would hang on a browser
#                    or a prompt nobody sees, so a Bash call starting with one
#                    is a human step, not a command. `|`-separated.
SIGN_IN_SHAPES="gh auth login|gh auth refresh|glab auth login|npm login|npm adduser|pnpm login|yarn npm login|gcloud auth login|gcloud auth application-default login|az login|aws sso login|aws configure sso|vercel login|netlify login|firebase login|heroku login|fly auth login|flyctl auth login|wrangler login|docker login|claude login|claude setup-token|op signin|doctl auth init|supabase login|railway login|stripe login|yarn login|terraform login|huggingface-cli login|gcloud init|eas login|expo login"
