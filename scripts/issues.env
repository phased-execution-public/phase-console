# The words for an issue a SESSION wants filed — the bash twin.
# SINGLE SOURCE OF TRUTH (F5 pattern, like gates.env), but the OWNER is
# viewer/shared/issues-model.js and this file is its bash half: sourced by
# scripts/phase-graph.sh (--issues, --issue-policy) and by scripts/phase-issue.sh.
# viewer/test/gates-vocab.test.ts asks bash for every list below and holds it
# to the JS owner word for word, so the two can never disagree. Change BOTH.
#
# Plain KEY="VALUE" (sourced by bash 3.2) — space-separated tokens; the
# budgets are bare integers, like scripts/mcp.env.

#   ISSUE_MODES / DEFAULT_ISSUES — how far a plan lets its sessions go.
#     off   — they may not ask. The default: a plan that never considered the
#             question must not start opening issues on somebody's repository.
#     draft — they write drafts; the console holds them in the inbox and a
#             person presses Approve. The recommended setting.
#     file  — they file at once, still through the console's one allow-listed
#             writer and still inside the budgets.
ISSUE_MODES="off draft file"
DEFAULT_ISSUES="off"

#   ISSUE_ACTIONS — what a session may ask for. `close` is in the list and is
#                   the one the console holds longest: a phase that believes it
#                   fixed something has not proved it until its work has
#                   LANDED, so a close waits on the landing ledger.
ISSUE_ACTIONS="file comment close"

#   ISSUE_STATES  — where a draft has got to. Eleven, because each is a
#                   different thing for a person to do, and because "it did not
#                   appear on GitHub" has five distinct causes a single `failed`
#                   hides. `pending-landing` is a close waiting for its phase to
#                   LAND (phase 12); it moves on by itself.
ISSUE_STATES="drafted duplicate pending-landing pending-approval filing filed commented closed discarded over-budget failed"

#   ISSUE_FIELDS  — the fields a draft carries. `number` is empty for `file`
#                   and required for `comment` and `close`; `type`, `severity`
#                   and `suggestion` ride a `file` draft (the ledger line spells
#                   the type `issue_type` — `type` is the line's discriminator).
ISSUE_FIELDS="action title body labels type severity suggestion repo number"

#   ISSUE_TYPES   — what kind of issue a draft is: GitHub's own three type
#                   labels (control-tower phase 114). `--type` takes one.
ISSUE_TYPES="bug enhancement documentation"

#   ISSUE_SEVERITIES / ISSUE_SEVERITY_RUBRIC — how bad, worst first, and each
#                   level's one-line meaning as `level=meaning|…` (the owner's
#                   ISSUE_SEVERITY_MEANINGS). The script prints the rubric when
#                   a bug names no severity, so a session chooses by the words.
#   DEFAULT_ISSUE_SEVERITY      — what a non-bug that names none is.
#   ISSUE_SEVERITY_REQUIRED_FOR — the types that must name one.
ISSUE_SEVERITIES="critical high medium low"
ISSUE_SEVERITY_RUBRIC="critical=data loss, a security or permission bypass, an unapproved production change, or every lane blocked|high=a run halts or parks, or reaches a wrong verdict, with no in-run workaround|medium=time or money wasted, a workaround exists|low=cosmetic, wording, noise"
DEFAULT_ISSUE_SEVERITY="low"
ISSUE_SEVERITY_REQUIRED_FOR="bug"

#   ISSUE_LABELS / ISSUE_SEVERITY_LABEL_PREFIX — the lifecycle labels a
#                   session-filed issue carries beside its type, and the prefix
#                   its severity is filed under (`severity:high`).
ISSUE_LABELS="awaiting-plan from-session"
ISSUE_SEVERITY_LABEL_PREFIX="severity:"

#   SUGGESTION_TYPE / ISSUE_SUGGEST_WORDS / DEFAULT_ISSUE_SUGGEST — a
#                   suggestion is always an enhancement, and a console takes
#                   them only under PE_ISSUES_SUGGEST=on (shipped off, operator
#                   decision 16).
SUGGESTION_TYPE="enhancement"
ISSUE_SUGGEST_WORDS="off on"
DEFAULT_ISSUE_SUGGEST="off"

#   ISSUE_REPO_AUTO / ROOT_REPO_KEY / CONSOLE_REPO_KEY — the repository keys
#                   that are not paths: `--repo auto` (the longest estate key
#                   that prefixes --where), the docs root, and the console's own
#                   repository. Never a prefix to match against.
ISSUE_REPO_AUTO="auto"
ROOT_REPO_KEY="root"
CONSOLE_REPO_KEY="console"

#   The budgets — three drafts per phase, and one suggestion. Small on
#   purpose: a phase with four things to report has found a CLASS of problem,
#   and a class is one issue with four bullets. A draft past the phase's three
#   is HELD for a person (`pending-approval`), never dropped (phase 114). There
#   is no run budget here: the console's per-day filing rate replaces it.
ISSUE_BUDGET_PHASE=3
ISSUE_BUDGET_SUGGESTION=1

#   The OPERATOR door's meters (control-tower phase 12): one draft per ticket,
#   ten a day (UTC) across every ticket. A person's button is not a phase and
#   not a run, so neither of the two above applies to it.
ISSUE_BUDGET_TICKET=1
ISSUE_BUDGET_OPERATOR_DAY=10

#   OPERATOR_ISSUE_SCOPE — the ledger an operator's draft lands in, written
#   where a plan slug goes. It starts with `_`, which no slug may.
OPERATOR_ISSUE_SCOPE="_operator"
