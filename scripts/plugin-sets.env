# Per-phase plugin sets (measured-console phase 27, D5) — the bash twin of
# viewer/shared/plugin-sets.js, which OWNS the table (each entry's edition, its
# unattended word, its env). This file carries the names alone: what
# `phase-graph.sh --plugins [N]` prints and what F48 `plugin-set-over-budget`
# counts. viewer/test/plugin-sets.test.ts holds the two equal.
#
# Plain KEY=VALUE (sourced by bash 3.2) — no spaces around '=', space-separated lists.
#
# A kind's entries are PLUGIN_SET_<kind>: `<plugin>@<marketplace>` (a whole
# plugin), `<plugin>:<skill>` (one skill of it) or a bare skill name. The sets
# are Pro; the Free tree keeps the kinds and resolves each to nothing.

PLUGIN_KINDS="review security planning release docs ui"
PLUGIN_SET_review=""
PLUGIN_SET_security=""
PLUGIN_SET_planning=""
PLUGIN_SET_release=""
PLUGIN_SET_docs=""
PLUGIN_SET_ui=""

# The listing budget: an entry costed at the CLI's 1,536-character cut, the
# set against 1 % of the phase model's window (200 K, or 1 M with [1m]) at 4
# characters a token — 8,000 characters, five entries, on a 200 K window.
PLUGIN_LISTING_PCT=1
PLUGIN_ENTRY_CHARS=1536
PLUGIN_CHARS_PER_TOKEN=4
PLUGIN_WINDOW=200000
PLUGIN_WINDOW_1M=1000000
