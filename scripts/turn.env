# Your turn — the words a person's task is told in, the bash twin
# (control-tower phase 130, #207).
# SINGLE SOURCE OF TRUTH (F5 pattern, like human-steps.env), but the OWNER is
# viewer/shared/turn-model.js (and, for the guide's limits,
# viewer/shared/guide-grammar.js). This file holds only what a SCRIPT reads:
# scripts/phase-outcome.sh (the --why, --proof-type and --guide flags of a
# needs-human --step declaration, and the guard's door-side rules) and
# scripts/phase-graph.sh (the plan bullet's why: key, F37). The console's
# guard reads the owner. viewer/test/gates-vocab.test.ts asks bash for every
# list below and holds it to the JS owner word for word. Change BOTH.
#
# Plain KEY="VALUE" (sourced by bash 3.2), space-separated tokens.

#   WHY_PERSON        — the ten reasons only a person fits an act. Every item
#                       carries one: --why names it, else its kind's default
#                       is taken and marked inferred.
WHY_PERSON="permission identity secret money legal decision physical reach third-party reserved"

#   G4_REASONS        — the reasons that CLAIM THE AI CANNOT. Only a declared
#                       one of these is judged by G4 ("could the AI have done
#                       it itself?"); a sign-in is the person's even when the
#                       run's policy would let its command run.
G4_REASONS="permission reach reserved"

#   KIND_REASONS      — kind:reason,reason… — the reasons each kind may
#                       carry; the FIRST is the kind's default. Total over
#                       human-steps.env's HUMAN_STEP_KINDS.
KIND_REASONS="browser-login:identity,secret device-code:identity one-time-code:identity,secret secret-entry:secret,identity,money claude-login:identity mcp-login:identity,secret os-prompt:physical,identity,secret os-permission:physical,permission third-party-approval:third-party,decision physical:physical person-check:decision,reserved decision:decision,money,legal,reserved protected-path:reserved,permission interactive-prompt:identity,secret,decision,physical captcha:identity email-link:identity,reach operator-act:reserved,permission,identity,secret,money,legal,decision,physical,reach,third-party permission:permission"

#   PROOF_TYPES       — probe (a ref the console reads) · answer (the person's
#                       answer is the result) · judgement (a checking session
#                       reads evidence against the proof's words) · attest
#                       (the person's word, by name only) · grant (a
#                       permission item ends by a grant or a denial).
PROOF_TYPES="probe answer judgement attest grant"

#   PROOF_TYPES_SELF  — the proof types that need neither a ref nor words (G2).
PROOF_TYPES_SELF="answer attest grant"

#   GUIDE_MAX_STEPS   — the most numbered steps a guide may hold.
#   GUIDE_MAX_BYTES   — the most a guide may weigh, in bytes (24 KB).
GUIDE_MAX_STEPS="20"
GUIDE_MAX_BYTES="24576"

#   GUARD_REFUSAL_EXIT — the exit a declaration G4 refused ends with: "the AI
#                       can do this itself" (2 is a malformed call, 3 a proof
#                       that is already true).
GUARD_REFUSAL_EXIT="4"

# Who handled something instead of asking a person, and what a handled row may
# link to (control-tower phase 136) — `phase-outcome.sh … handled` writes the
# `session` source and holds each --link to these kinds.
HANDLED_SOURCES="guard auto-grant relay-rule ladder supervisor session"
HANDLED_LINK_KINDS="commit pr issue journal"
